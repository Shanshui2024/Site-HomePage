# ==========================================
# 网站基础配置示例
# ==========================================
# 复制此文件为 .env.local 并填入实际值

# 网站 URL（用于 SEO 和 Open Graph）
# 开发环境: http://localhost:3000
# 生产环境: https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 网站名称
NEXT_PUBLIC_SITE_NAME=你的网站名称
NEXT_PUBLIC_SITE_SHORT_NAME=简称

# 网站标题和描述
NEXT_PUBLIC_SITE_TITLE=网站标题
NEXT_PUBLIC_SITE_DESCRIPTION=网站描述

# 网站关键词（用逗号分隔）
NEXT_PUBLIC_SITE_KEYWORDS=关键词1,关键词2,关键词3

# ==========================================
# 个人信息配置
# ==========================================

# 个人基本信息
NEXT_PUBLIC_PROFILE_NAME=你的名字
NEXT_PUBLIC_PROFILE_TITLE=你的职位
NEXT_PUBLIC_PROFILE_BIO=个人简介
NEXT_PUBLIC_PROFILE_AVATAR=/images/avatar.jpg
NEXT_PUBLIC_PROFILE_EMAIL=your@email.com

# 社交链接
NEXT_PUBLIC_GITHUB_URL=https://github.com/yourusername
NEXT_PUBLIC_BILIBILI_URL=https://space.bilibili.com/your-uid
NEXT_PUBLIC_QQ_URL=https://qm.qq.com/q/your-qq-link

# 可选的社交链接
# NEXT_PUBLIC_TWITTER_URL=https://twitter.com/yourusername
# NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/yourusername

# ==========================================
# SEO 配置
# ==========================================

# Open Graph 图片
NEXT_PUBLIC_OG_IMAGE=/images/og-image.jpg
NEXT_PUBLIC_OG_IMAGE_WIDTH=1200
NEXT_PUBLIC_OG_IMAGE_HEIGHT=630

# 网站语言
NEXT_PUBLIC_SITE_LOCALE=zh_CN

# ==========================================
# 搜索引擎验证（可选）
# ==========================================

# Google Search Console 验证码
# NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-verification-code

# Yandex 验证码
# NEXT_PUBLIC_YANDEX_VERIFICATION=your-yandex-verification-code

# Bing 验证码
# NEXT_PUBLIC_BING_VERIFICATION=your-bing-verification-code

# ==========================================
# Umami 统计分析（可选）
# ==========================================
# 官网: https://umami.is
# 支持自托管或 Umami Cloud

# 是否启用 Umami 统计（true/false）
NEXT_PUBLIC_UMAMI_ENABLED=false

# Umami 网站 ID（在 Umami 后台创建网站后获取）
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Umami 跟踪脚本地址（默认使用 Umami Cloud，自托管请改为你自己的地址）
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# ==========================================
# 主题配置
# ==========================================

# 主题色（用于 PWA 和浏览器主题）
NEXT_PUBLIC_THEME_COLOR=#2563eb
NEXT_PUBLIC_BACKGROUND_COLOR=#ffffff
